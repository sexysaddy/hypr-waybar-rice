# ==============================================================================
# ОБЩИЕ НАСТРОЙКИ И ИНТЕРФЕЙС
# ==============================================================================
set linenumbers      # Показывать номера строк слева
set positionlog      # Запоминать позицию курсора при прошлом открытии файла
set historylog       # Запоминать историю поисковых запросов
set mouse            # Включить поддержку мыши (клики, скролл)
set indicator        # Показывать мини-полосу прокрутки справа

# ==============================================================================
# ФОРМАТИРОВАНИЕ И ТАБУЛЯЦИЯ
# ==============================================================================
set tabsize 4        # Размер табуляции — 4 пробела
set tabstospaces     # Конвертировать табы в пробелы при нажатии Tab
set autoindent       # Автоматический отступ на уровень предыдущей строки

# ==============================================================================
# РАБОТА С ТЕКСТОМ И СТРОКАМИ
# ==============================================================================
set softwrap         # Мягкий перенос длинных строк (без создания символа новой строки)
set atblanks         # Переносить строки строго по пробелам, а не посреди слова
set fill 80          # Мягкая граница текста в 80 символов
set breaklonglines   # Жесткий перенос строк при достижении fill (если нужно)
set casesensitive    # Поиск с учетом регистра по умолчанию
set regexp           # Использовать регулярные выражения в поиске по умолчанию
set speller "aspell -x -c" # Проверка орфографии (требует установленного aspell)

# ==============================================================================
# ПОД СВЕТКА СИНТАКСИСА
# ==============================================================================
# Включаем стандартные правила подсветки для разных языков программирования
include "/usr/share/nano/*.nanorc"

# ==============================================================================
# СТИЛЬ И ЦВЕТОВАЯ ПАЛИТРА (Красивая современная тема)
# ==============================================================================
set titlecolor       brightwhite,blue    # Верхняя панель: яркий белый на синем фоне
set statuscolor      brightwhite,cyan    # Строка состояния: белый на бирюзовом
set errorcolor       brightred,black     # Ошибки: ярко-красный на черном
set selectedcolor    black,brightyellow  # Выделенный текст: черный на ярко-желтом
set numbercolor      cyan,black          # Номера строк: бирюзовый (приятнее для глаз, чем зеленый)
set keycolor         brightcyan,black    # Подсказки клавиш внизу: яркий бирюзовый
set functioncolor    white,black         # Описание функций внизу: белый

