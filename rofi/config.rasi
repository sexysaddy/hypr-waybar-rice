configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

@theme "ib"

// color pallete
* {
    font:                        "SpaceMono Nerd Font 10";
    background:                  #13121C80;
//   background:                  #13121C;
    background-alt:              #19182180;
    foreground:                  #E7E2FF;
    selected:                    #2A82C9;
    active:                      #FFA9E2;
    urgent:                      #FF6E84;
}

// theme image (image height is set via y-padding)
inputbar {
    background-image:            url("images/sky-gilr.jpg", width);
    padding:                     75px 60px;
}

window {
    transparency:                "real";
    background-color:            @background;
    border-radius:               60px; /* Задаёт скругление углов самого окна */
    height:                      500px;
    width:			 500px;
}

textbox-prompt-colon {
    enabled:                     false;
}


